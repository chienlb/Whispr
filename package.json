{
  "name": "whispr-chat",
  "version": "1.0.0",
  "description": "Whispr Universal Social Workspace Platform",
  "author": "Whispr Corporation <contact@whispr.io>",
  "homepage": "https://whispr.io",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/server/server.js",
    "dev": "node src/server/server.js",
    "landing:dev": "npm --prefix landing run dev",
    "landing:build": "npm --prefix landing run build",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.whispr.social",
    "productName": "Whispr Social Enterprise",
    "copyright": "Copyright © 2026 Whispr Corporation",
    "directories": {
      "output": "release_exe"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/renderer/assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Whispr Social Enterprise"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
